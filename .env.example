# ==============================================================================
# DeployMind Enterprise Configuration
# Complete environment variable specification for autonomous self-hosting
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. APPLICATION & HTTP SERVER
# ------------------------------------------------------------------------------
# Name of the deployment instance
APP_NAME=DeployMind

# Runtime environment ('development' | 'production' | 'test')
NODE_ENV=development

# Host address to bind the API & WebSocket server (0.0.0.0 binds all interfaces)
HOST=0.0.0.0

# HTTP Port for the DeployMind backend API
PORT=3000

# ------------------------------------------------------------------------------
# 2. STORAGE & PERSISTENCE
# ------------------------------------------------------------------------------
# Directory for embedded database, Git repository checkouts, and runtime files
DEPLOYMIND_DATA_DIR=.data

# Absolute or relative path to the embedded SQLite database
DEPLOYMIND_DB_PATH=.data/deploymind.sqlite

# 32-byte hexadecimal master key for AES-256-GCM Vault credentials encryption
# If left empty, DeployMind autonomously generates and persists master.key in DATA_DIR
DEPLOYMIND_MASTER_KEY=

# ------------------------------------------------------------------------------
# 3. REVERSE PROXY & INGRESS ROUTING
# ------------------------------------------------------------------------------
# Reverse proxy provider ('caddy' | 'traefik')
PROXY_PROVIDER=caddy

# Base top-level domain for automated project subdomains (e.g. recordly.localhost)
BASE_DOMAIN=localhost

# Caddy administrative configuration endpoint
CADDY_API_URL=http://127.0.0.1:2019

# Container name for Caddy reverse proxy
CADDY_CONTAINER_NAME=deploymind-caddy

# Directory for Traefik dynamic file routing (if PROXY_PROVIDER=traefik)
TRAEFIK_DYNAMIC_DIR=.data/traefik/dynamic

# ------------------------------------------------------------------------------
# 4. DOCKER CONTAINER ENGINE
# ------------------------------------------------------------------------------
# Local Docker daemon socket path
# macOS default: ~/.docker/run/docker.sock or /var/run/docker.sock
# Linux default: /var/run/docker.sock
DOCKER_SOCKET_PATH=

# Dedicated bridge network for DeployMind containers and reverse proxy
DOCKER_NETWORK_NAME=deploymind-net

# Prefix prepended to deployed application container names
CONTAINER_NAME_PREFIX=app_proj_

# Grace period in seconds when stopping containers before SIGKILL
DOCKER_STOP_TIMEOUT_SECONDS=10

# ------------------------------------------------------------------------------
# 5. ARTIFICIAL INTELLIGENCE - SYSTEM 1 (TYPESAFE JEV)
# ------------------------------------------------------------------------------
# TypeSafe AI Jev API Key for sub-second, non-autoregressive decision classification
# (Optional: falls back to built-in calibrated local decision matrix)
TYPESAFE_API_KEY=
JEV_API_KEY=

# TypeSafe Jev evaluation endpoint
JEV_API_URL=https://api.typesafe.ai/v1/jev/evaluate

# Request timeout in milliseconds for TypeSafe Jev classification
JEV_TIMEOUT_MS=5000

# ------------------------------------------------------------------------------
# 6. ARTIFICIAL INTELLIGENCE - SYSTEM 2 (CHATGPT / REASONING)
# ------------------------------------------------------------------------------
# Primary AI reasoner provider ('openai' | 'anthropic' | 'gemini' | 'ollama')
AI_PROVIDER=openai

# OpenAI API Key for GPT-4o conversational reasoning
# (Optional: DeployMind includes local fallback reasoning if no key is provided)
AI_API_KEY=
OPENAI_API_KEY=

# OpenAI model identifier
AI_MODEL=gpt-4o
OPENAI_MODEL=gpt-4o

# OpenAI API completion endpoint
OPENAI_API_URL=https://api.openai.com/v1/chat/completions

# Timeout for OpenAI reasoning in milliseconds
OPENAI_TIMEOUT_MS=15000

# Sampling temperature (0.0 = deterministic, 1.0 = creative)
OPENAI_TEMPERATURE=0.3

# Maximum tokens for response synthesis
OPENAI_MAX_TOKENS=1024

# Local Ollama endpoint (if AI_PROVIDER=ollama)
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3:8b

# ------------------------------------------------------------------------------
# 7. GIT REPOSITORY & PIPELINE ENGINE
# ------------------------------------------------------------------------------
# Default git branch fallback when auto-detecting repositories
GIT_DEFAULT_BRANCH=main

# Timeout for repository shallow cloning in milliseconds
GIT_CLONE_TIMEOUT_MS=120000

# Timeout for git pull operations in milliseconds
GIT_PULL_TIMEOUT_MS=60000

# Timeout for git branch checkout in milliseconds
GIT_CHECKOUT_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# 8. HEALTH OBSERVATION & AUTONOMOUS REMEDIATION
# ------------------------------------------------------------------------------
# Timeout per HTTP health probe request in milliseconds
HEALTH_CHECK_TIMEOUT_MS=4000

# Maximum probe attempts before triggering autonomous diagnostic healing
HEALTH_CHECK_MAX_RETRIES=6

# Delay between health probe retries in milliseconds
HEALTH_CHECK_INTERVAL_MS=1500

# ------------------------------------------------------------------------------
# 9. TELEMETRY, LOGS & PURGE RETENTION
# ------------------------------------------------------------------------------
# Number of days to retain deployment and execution logs before pruning
LOG_RETENTION_DAYS=7

# Default number of lines returned for container log tail queries
LOG_DEFAULT_TAIL_LINES=100
